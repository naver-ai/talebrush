# Copy to .env and fill in. OpenAI: leave LLM_BASE_URL as is. OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional: model used for rating sentences (defaults to LLM_MODEL)
LLM_RATER_MODEL=
# Set to 1 for fake sentences/ratings with no network calls
LLM_MOCK=0
